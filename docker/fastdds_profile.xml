<?xml version="1.0" encoding="UTF-8" ?>
<!-- Транспорт DDS под большие облака точек: UDP с расширенными буферами.

     Кадр 128-луча — 24 МБ в одном сообщении. С буферами сокетов по умолчанию
     (около 200 КБ) такое сообщение режется на фрагменты по 64 КБ и теряется
     ими же. Расширенные буферы и RELIABLE-подписка (см. obstacle_detector)
     закрывают потери: издатель дошлёт то, что не дошло.

     Разделяемая память здесь не задействована — этот профиль рассчитан на
     обмен с процессами вне контейнера. Когда запись проигрывается внутри
     контейнера и /dev/shm достаточно велик, entrypoint подключает
     docker/fastdds_shm.xml, где фрагментации нет вовсе.

     Подключается переменной FASTRTPS_DEFAULT_PROFILES_FILE (см. entrypoint);
     свой профиль подставляется той же переменной. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_large</transport_id>
        <type>UDPv4</type>
        <sendBufferSize>33554432</sendBufferSize>
        <receiveBufferSize>33554432</receiveBufferSize>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="large_clouds" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>udp_large</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
